generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  id            String                 @id @default(uuid())
  name          String
  email         String                 @unique
  phoneNumber   String?                @unique
  provider      String?
  providerId    String?
  password      String?
  isVerified    Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  deletedAt     DateTime?
  carts         Cart?
  transactions  Transaction[]
  addresses     UserAddress[]
  discountUsage DiscountUsageHistory[]

  @@unique([provider, providerId])
}

model UserAddress {
  id                  String  @id @default(uuid())
  addressLabel        String
  userId              String
  receiverName        String
  receiverPhoneNumber String
  addressDisplayName  String
  addressDetails      String
  lat                 Decimal @db.Decimal(9, 6)
  lon                 Decimal @db.Decimal(9, 6)
  isDefault           Boolean @default(false)

  // Redundant information
  provinceId Int
  province   String
  cityId     Int
  city       String
  district   String
  districtId Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      Users     @relation(fields: [userId], references: [id])
}

model Store {
  id          String         @id @default(uuid())
  provinceId  Int
  province    String
  cityId      Int
  city        String
  district    String
  districtId  Int
  address     String
  name        String
  lat         Decimal?       @db.Decimal(9, 6)
  lng         Decimal?       @db.Decimal(9, 6)
  radiusKm    Decimal        @db.Decimal(6, 2)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  admins      Admin[]
  cartItems   CartProduct[]
  storeStock  StoreProduct[]
  discounts   Discount[]
  Transaction Transaction[]
}

model Admin {
  id               String                 @id @default(uuid())
  storeId          String?
  name             String
  email            String                 @unique
  password         String
  isSuper          Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?
  store            Store?                 @relation(fields: [storeId], references: [id])
  stockJournal     StockJournal[]
  createdDiscounts Discount[]             @relation("DiscountCreator")
  appliedDiscounts DiscountUsageHistory[] @relation("DiscountApplier")
}

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique // URL-friendly slug for categories
  description String?
  icon        String? // Icon identifier for the category
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  products    Product[]
}

model Product {
  id               String               @id @default(uuid())
  name             String
  description      String
  slug             String               @unique
  price            Int
  zIndex           Int?
  picture1         String
  picture2         String?
  picture3         String?
  picture4         String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  categoryId       String
  isActive         Boolean              @default(true)
  weight           Float?
  cartItems        CartProduct[]
  category         ProductCategory      @relation(fields: [categoryId], references: [id])
  storeStock       StoreProduct[]
  trxProducts      TransactionProduct[]
  discountProducts DiscountProduct[]
}

model StoreProduct {
  storeId      String
  productId    String
  stock        Int
  minStock     Int?           @default(5)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  product      Product        @relation(fields: [productId], references: [id])
  store        Store          @relation(fields: [storeId], references: [id])
  stockJournal StockJournal[]

  @@id([storeId, productId])
}

model StockJournal {
  id            String        @id @default(uuid())
  storeId       String
  productId     String
  adminId       String
  transactionId String?
  type          StockMovement
  quantity      Int
  beforeStock   Int
  afterStock    Int
  notes         String?
  createdAt     DateTime      @default(now())
  admin         Admin         @relation(fields: [adminId], references: [id])
  storeProduct  StoreProduct  @relation(fields: [storeId, productId], references: [storeId, productId])
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])

  @@index([storeId, productId])
  @@index([adminId])
  @@index([createdAt])
}

model VoucherProduct {
  code        String        @id
  discount    Int?
  quota       Int
  maxDiscount Int
  expiredDate DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  trx         Transaction[]
}

model VoucherDelivery {
  code        String        @id
  discount    Int?
  quota       Int
  maxDiscount Int
  expiredDate DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  trx         Transaction[]
}

model Cart {
  id        String        @id @default(uuid())
  userId    String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  user      Users         @relation(fields: [userId], references: [id])
  items     CartProduct[]
}

model CartProduct {
  id        String    @id @default(uuid())
  cartId    String
  productId String
  storeId   String
  quantity  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  cart      Cart      @relation(fields: [cartId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  store     Store     @relation(fields: [storeId], references: [id])

  @@unique([cartId, productId, storeId])
}

model Transaction {
  id                   String                 @id @default(uuid())
  userId               String
  storeId              String
  status               OrderStatus            @default(waiting_payment)
  shippingPrice        Int
  discountedShipping   Int?                   @default(0) // potongan ongkir dari voucher
  finalShippingPrice   Int // shippingPrice - discountedShipping
  totalPrice           Int
  address              String
  phoneNumber          String
  provinceId           Int
  province             String
  cityId               Int
  city                 String
  district             String
  districtId           Int
  codeVoucherProduct   String?
  codeVoucherDelivery  String?
  paymentProof         String?
  paymentMethod        String? // BARU: Menyimpan metode bayar (e.g., "gopay", "bca_va", "manual_transfer")
  snapToken            String?                @db.Text // Token dari Midtrans
  snapRedirectUrl      String?                @db.Text // URL redirect dari Midtrans
  paidAt               DateTime? // BARU: Waktu saat pembayaran lunas
  expiryAt             DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  store                Store                  @relation(fields: [storeId], references: [id])
  voucherDelivery      VoucherDelivery?       @relation(fields: [codeVoucherDelivery], references: [code])
  voucherProduct       VoucherProduct?        @relation(fields: [codeVoucherProduct], references: [code])
  user                 Users                  @relation(fields: [userId], references: [id])
  products             TransactionProduct[]
  stockJournal         StockJournal[]
  discountUsageHistory DiscountUsageHistory[]
}

model TransactionProduct {
  id            String      @id @default(uuid())
  transactionId String
  productId     String
  quantity      Int
  price         Int
  discount      Int         @default(0) // potongan harga untuk produk ini
  finalPrice    Int // (price - discount) * quantity
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  product       Product     @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

enum OrderStatus {
  waiting_payment
  waiting_confirmation
  on_process
  shipped
  completed
  cancelled
}

enum StockMovement {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  INITIAL
}

model Discount {
  id                  String                 @id @default(uuid())
  storeId             String
  name                String
  description         String?
  type                DiscountType
  valueType           DiscountValueType
  value               Int // percentage (1-100) or nominal amount
  maxDiscountAmount   Int? // max discount for percentage type
  minTransactionValue Int? // minimum transaction for discount to apply
  maxUsagePerCustomer Int? // max times a customer can use this discount
  totalUsageLimit     Int? // total usage limit across all customers
  currentUsageCount   Int                    @default(0)
  isActive            Boolean                @default(true)
  startDate           DateTime
  endDate             DateTime
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?
  adminId             String // who created the discount
  store               Store                  @relation(fields: [storeId], references: [id])
  admin               Admin                  @relation("DiscountCreator", fields: [adminId], references: [id])
  products            DiscountProduct[]
  usageHistory        DiscountUsageHistory[]
  bogoConfig          BogoDiscount?

  @@index([storeId])
  @@index([isActive])
  @@index([startDate, endDate])
}

model DiscountProduct {
  id         String   @id @default(uuid())
  discountId String
  productId  String
  createdAt  DateTime @default(now())
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([discountId, productId])
}

model BogoDiscount {
  id                 String   @id @default(uuid())
  discountId         String   @unique
  buyQuantity        Int // quantity to buy
  getQuantity        Int // quantity to get free
  applyToSameProduct Boolean  @default(true) // if false, can get different product
  maxBogoSets        Int? // max number of BOGO sets per transaction
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  discount           Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model DiscountUsageHistory {
  id            String       @id @default(uuid())
  discountId    String
  transactionId String?
  userId        String?
  adminId       String? // if manually applied by admin
  usedAt        DateTime     @default(now())
  discountValue Int // actual discount amount applied
  orderTotal    Int // total order amount when discount was applied
  createdAt     DateTime     @default(now())
  discount      Discount     @relation(fields: [discountId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  user          Users?       @relation(fields: [userId], references: [id])
  appliedBy     Admin?       @relation("DiscountApplier", fields: [adminId], references: [id])

  @@index([discountId])
  @@index([transactionId])
  @@index([userId])
  @@index([usedAt])
}

enum DiscountType {
  MANUAL // Can be applied manually by admin
  MINIMUM_PURCHASE // Requires minimum transaction value
  BOGO // Buy One Get One
  AUTOMATIC // Automatically applied when conditions are met
}

enum DiscountValueType {
  PERCENTAGE // Discount in percentage (1-100)
  NOMINAL // Fixed amount discount
}
