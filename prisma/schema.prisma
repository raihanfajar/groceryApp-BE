generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "darwin-arm64", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  id             String                 @id @default(uuid())
  name           String
  email          String                 @unique
  phoneNumber    String?                @unique
  password       String?
  isVerified     Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
  provider       String?
  providerId     String?
  profilePicture String?
  carts          Cart?
  discountUsage  DiscountUsageHistory[]
  transactions   Transaction[]
  addresses      UserAddress[]

  @@unique([provider, providerId])
}

model UserAddress {
  id                  String    @id @default(uuid())
  userId              String
  province            String
  city                String
  lat                 Decimal   @db.Decimal(9, 6)
  isDefault           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  cityId              Int
  provinceId          Int
  addressDetails      String
  addressDisplayName  String
  addressLabel        String
  lon                 Decimal   @db.Decimal(9, 6)
  receiverName        String
  receiverPhoneNumber String
  district            String
  districtId          Int
  user                Users     @relation(fields: [userId], references: [id])
}

model Store {
  id          String         @id @default(uuid())
  province    String
  city        String
  address     String
  name        String
  lat         Decimal?       @db.Decimal(9, 6)
  lng         Decimal?       @db.Decimal(9, 6)
  radiusKm    Decimal        @db.Decimal(6, 2)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  cityId      Int
  provinceId  Int
  district    String
  districtId  Int
  admins      Admin[]
  cartItems   CartProduct[]
  discounts   Discount[]
  storeStock  StoreProduct[]
  Transaction Transaction[]
}

model Admin {
  id               String                 @id @default(uuid())
  storeId          String?
  name             String
  email            String                 @unique
  password         String
  isSuper          Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?
  store            Store?                 @relation(fields: [storeId], references: [id])
  createdDiscounts Discount[]             @relation("DiscountCreator")
  appliedDiscounts DiscountUsageHistory[] @relation("DiscountApplier")
  stockJournal     StockJournal[]
}

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  icon        String?
  slug        String    @unique
  products    Product[]
}

model Product {
  id               String               @id @default(uuid())
  name             String
  description      String
  slug             String               @unique
  price            Int
  zIndex           Int?
  picture1         String
  picture2         String?
  picture3         String?
  picture4         String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  categoryId       String
  isActive         Boolean              @default(true)
  weight           Float
  cartItems        CartProduct[]
  discountProducts DiscountProduct[]
  category         ProductCategory      @relation(fields: [categoryId], references: [id])
  storeStock       StoreProduct[]
  trxProducts      TransactionProduct[]
}

model StoreProduct {
  storeId      String
  productId    String
  stock        Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  minStock     Int?           @default(5)
  stockJournal StockJournal[]
  product      Product        @relation(fields: [productId], references: [id])
  store        Store          @relation(fields: [storeId], references: [id])

  @@id([storeId, productId])
}

model StockJournal {
  id            String        @id @default(uuid())
  storeId       String
  productId     String
  adminId       String
  transactionId String?
  type          StockMovement
  quantity      Int
  beforeStock   Int
  afterStock    Int
  notes         String?
  createdAt     DateTime      @default(now())
  admin         Admin         @relation(fields: [adminId], references: [id])
  storeProduct  StoreProduct  @relation(fields: [storeId, productId], references: [storeId, productId])
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])

  @@index([storeId, productId])
  @@index([adminId])
  @@index([createdAt])
}

model VoucherProduct {
  code        String        @id
  discount    Int?
  quota       Int
  maxDiscount Int
  expiredDate DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  trx         Transaction[]
}

model VoucherDelivery {
  code        String        @id
  discount    Int?
  quota       Int
  maxDiscount Int
  expiredDate DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  trx         Transaction[]
}

model Cart {
  id        String        @id @default(uuid())
  userId    String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  user      Users         @relation(fields: [userId], references: [id])
  items     CartProduct[]
}

model CartProduct {
  id        String    @id @default(uuid())
  cartId    String
  productId String
  storeId   String
  quantity  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  cart      Cart      @relation(fields: [cartId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  store     Store     @relation(fields: [storeId], references: [id])

  @@unique([cartId, productId, storeId])
}

model Transaction {
  id                     String                 @id @default(uuid())
  userId                 String
  status                 OrderStatus            @default(waiting_payment)
  shippingPrice          Int
  totalPrice             Int
  phoneNumber            String
  codeVoucherProduct     String?
  codeVoucherDelivery    String?
  paymentProof           String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?
  address                String
  city                   String
  cityId                 Int
  discountedShipping     Int                    @default(0)
  finalShippingPrice     Int
  province               String
  provinceId             Int
  storeId                String
  expiryAt               DateTime?
  paidAt                 DateTime?
  paymentMethod          String?
  snapRedirectUrl        String?
  snapToken              String?
  district               String
  districtId             Int
  discountedProductPrice Int                    @default(0)
  finalProductPrice      Int
  totalProductPrice      Int
  receiverName           String
  addressLabel           String
  discountUsageHistory   DiscountUsageHistory[]
  stockJournal           StockJournal[]
  voucherDelivery        VoucherDelivery?       @relation(fields: [codeVoucherDelivery], references: [code])
  voucherProduct         VoucherProduct?        @relation(fields: [codeVoucherProduct], references: [code])
  store                  Store                  @relation(fields: [storeId], references: [id])
  user                   Users                  @relation(fields: [userId], references: [id])
  products               TransactionProduct[]
}

model TransactionProduct {
  id            String      @id @default(uuid())
  transactionId String
  productId     String
  quantity      Int
  price         Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  discount      Int         @default(0)
  finalPrice    Int
  product       Product     @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model Discount {
  id                  String                 @id @default(uuid())
  storeId             String?
  name                String
  description         String?
  type                DiscountType
  valueType           DiscountValueType
  value               Int
  maxDiscountAmount   Int?
  minTransactionValue Int?
  maxUsagePerCustomer Int?
  totalUsageLimit     Int?
  currentUsageCount   Int                    @default(0)
  isActive            Boolean                @default(true)
  startDate           DateTime
  endDate             DateTime
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?
  adminId             String
  // Marketing/Jumbotron fields
  isMarketingPromo    Boolean                @default(false)
  bannerImageUrl      String?
  displayOrder        Int?
  bogoConfig          BogoDiscount?
  admin               Admin                  @relation("DiscountCreator", fields: [adminId], references: [id])
  store               Store?                 @relation(fields: [storeId], references: [id])
  products            DiscountProduct[]
  usageHistory        DiscountUsageHistory[]

  @@index([storeId])
  @@index([isActive])
  @@index([startDate, endDate])
  @@index([isMarketingPromo])
}

model DiscountProduct {
  id         String   @id @default(uuid())
  discountId String
  productId  String
  createdAt  DateTime @default(now())
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([discountId, productId])
}

model BogoDiscount {
  id                 String   @id @default(uuid())
  discountId         String   @unique
  buyQuantity        Int
  getQuantity        Int
  applyToSameProduct Boolean  @default(true)
  maxBogoSets        Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  discount           Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model DiscountUsageHistory {
  id            String       @id @default(uuid())
  discountId    String
  transactionId String?
  userId        String?
  adminId       String?
  usedAt        DateTime     @default(now())
  discountValue Int
  orderTotal    Int
  createdAt     DateTime     @default(now())
  appliedBy     Admin?       @relation("DiscountApplier", fields: [adminId], references: [id])
  discount      Discount     @relation(fields: [discountId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  user          Users?       @relation(fields: [userId], references: [id])

  @@index([discountId])
  @@index([transactionId])
  @@index([userId])
  @@index([usedAt])
}

enum OrderStatus {
  waiting_payment
  waiting_confirmation
  on_process
  shipped
  completed
  cancelled
}

enum StockMovement {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  INITIAL
}

enum DiscountType {
  MANUAL
  MINIMUM_PURCHASE
  BOGO
  REGULAR
}

enum DiscountValueType {
  PERCENTAGE
  NOMINAL
}
